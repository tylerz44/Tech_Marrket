@model TechMarket.Models.Store
@{ Layout = "/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Chỉnh sửa cửa hàng"; }
<div class="container py-4" style="max-width:760px"><h2 class="fw-bold mb-4">Chỉnh sửa cửa hàng #@Model.Id</h2><form asp-action="Edit" method="post" class="card card-body border-0 shadow-sm">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="OwnerId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="StoreName" class="form-label">Tên cửa hàng</label><input asp-for="StoreName" class="form-control mb-3"/><span asp-validation-for="StoreName" class="text-danger"></span><label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control mb-3" rows="3"></textarea><label asp-for="Address" class="form-label">Địa chỉ</label><input asp-for="Address" class="form-control mb-3"/><label asp-for="Phone" class="form-label">Số điện thoại</label><input asp-for="Phone" class="form-control mb-3"/><button class="btn btn-primary">Lưu thay đổi</button><a asp-action="Index" class="btn btn-link mt-2">Quay lại</a></form></div>
