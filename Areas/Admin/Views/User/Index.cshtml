@model IEnumerable<TechMarket.Areas.Admin.Controllers.UserAdminRow>
@{ Layout = "/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Quản lý tài khoản"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><small class="text-uppercase text-secondary">ADMIN / USERS</small><h2 class="fw-bold">Quản lý tài khoản người dùng</h2></div></div>
@if (TempData["Success"] != null){<div class="alert alert-success">@TempData["Success"]</div>} @if (TempData["Error"] != null){<div class="alert alert-danger">@TempData["Error"]</div>}
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm tên hoặc email" /></div><div class="col-md-3"><select name="role" class="form-select"><option value="">Tất cả quyền</option><option value="Customer" selected="@(ViewBag.Role as string == "Customer")">Customer</option><option value="StoreOwner" selected="@(ViewBag.Role as string == "StoreOwner")">StoreOwner</option><option value="Admin" selected="@(ViewBag.Role as string == "Admin")">Admin</option></select></div><div class="col-md-3"><button class="btn btn-dark w-100">Lọc</button></div></form>
<div class="table-responsive bg-white rounded-3 border"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Người dùng</th><th>Điện thoại</th><th>Quyền</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var u in Model){<tr><td><strong>@u.FullName</strong><div class="small text-muted">@u.Email</div></td><td>@u.Phone</td><td><span class="badge bg-info text-dark">@u.Role</span></td><td>@u.CreatedAt.ToString("dd/MM/yyyy")</td><td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Hoạt động" : "Đã khóa")</span></td><td><div class="d-flex flex-wrap gap-1"><form asp-action="ToggleStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Khóa" : "Mở khóa")</button></form></div></td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Không có tài khoản phù hợp.</td></tr>}
</tbody></table></div></div>
