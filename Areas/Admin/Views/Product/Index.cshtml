@model IEnumerable<TechMarket.Areas.Admin.Controllers.ProductAdminRow>
@{ Layout = "/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><small class="text-uppercase text-secondary">ADMIN / PRODUCTS</small><h2 class="fw-bold">Quản lý sản phẩm</h2></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm</a></div>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}
<form method="get" class="row g-2 mb-3"><div class="col-lg-4"><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tên sản phẩm"/></div><div class="col-lg-3"><select name="categoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Tất cả danh mục</option></select></div><div class="col-lg-3"><select name="storeId" asp-items="ViewBag.Stores" class="form-select"><option value="">Tất cả cửa hàng</option></select></div><div class="col-lg-2"><button class="btn btn-dark w-100">Lọc</button></div></form>
<div class="table-responsive bg-white border rounded-3"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Sản phẩm</th><th>Danh mục</th><th>Cửa hàng</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var row in Model){var p=row.Product;<tr><td><div class="d-flex align-items-center gap-2">@if(!string.IsNullOrEmpty(p.ImageUrl)){<img src="@p.ImageUrl" style="width:48px;height:48px;object-fit:cover;border-radius:8px"/>}<div><strong>@p.Name</strong><div class="small text-muted">#@p.Id</div></div></div></td><td>@p.Category?.Name</td><td>@row.StoreName</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Quantity</td><td><span class="badge @(p.IsActive?"bg-success":"bg-secondary")">@(p.IsActive?"Hiển thị":"Đã ẩn")</span></td><td><div class="d-flex gap-1"><a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Sửa</a><form asp-action="ToggleStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-secondary">@(p.IsActive?"Ẩn":"Hiện")</button></form></div></td></tr>}
@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm.</td></tr>}
</tbody></table></div></div>
