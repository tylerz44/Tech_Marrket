@model TechMarket.Models.Product
@{ Layout = "/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Chỉnh sửa sản phẩm"; }
<div class="container py-4" style="max-width:850px"><h2 class="fw-bold mb-4">Chỉnh sửa sản phẩm #@Model.Id</h2><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body border-0 shadow-sm">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="CreatedAt" type="hidden"/><partial name="_Form" model="Model"/><button class="btn btn-primary">Lưu thay đổi</button><a asp-action="Index" class="btn btn-link mt-2">Quay lại</a></form></div>
