@model IEnumerable<TechMarket.Models.Product>

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý sản phẩm";

    var products = Model?.ToList() ?? new List<TechMarket.Models.Product>();

    int totalProducts = products.Count;
    int activeProducts = products.Count(p => p.IsActive);
    int hiddenProducts = products.Count(p => !p.IsActive);
    int totalStock = products.Sum(p => p.Quantity);
}

<style>
    .tm-page {
        min-height: 85vh;
        padding: 40px 0 60px;
        background: #F8F9FC;
    }

    .tm-container {
        max-width: 1500px;
        margin: auto;
        padding: 0 24px;
    }

    /* HEADER */
    .tm-hero {
        position: relative;
        overflow: hidden;
        padding: 38px;
        margin-bottom: 28px;
        color: white;
        background: linear-gradient(135deg, #0A111D, #132C4F);
        border-radius: 18px;
        box-shadow: 0 12px 30px rgba(10,17,29,.10);
    }

        .tm-hero::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: 10%;
            top: -140px;
            border: 1px solid rgba(214,185,140,.25);
            border-radius: 50%;
            box-shadow: 0 0 0 35px rgba(255,255,255,.035), 0 0 0 70px rgba(255,255,255,.025);
        }

    .tm-hero-content {
        position: relative;
        z-index: 1;
    }

    .tm-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #D6B98C;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .tm-hero h2 {
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .tm-hero p {
        max-width: 650px;
        color: #B9C6D8;
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 14px;
    }

    .tm-store-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border: 1px solid rgba(214,185,140,.3);
        border-radius: 30px;
        background: rgba(255,255,255,.06);
        color: #E5D2B4;
        font-size: 12px;
        font-weight: 600;
    }

    .tm-hero-icon {
        position: relative;
        z-index: 1;
        color: rgba(214,185,140,.75);
        font-size: 70px;
        text-align: center;
    }

    .tm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .2s;
        border: 1px solid transparent;
    }

    .tm-btn-gold {
        color: #0A111D;
        background: #D6B98C;
    }

        .tm-btn-gold:hover {
            color: #0A111D;
            background: #E7D2B2;
            transform: translateY(-2px);
        }

    .tm-btn-outline {
        color: #E4EAF2;
        border-color: rgba(255,255,255,.25);
        background: rgba(255,255,255,.06);
    }

        .tm-btn-outline:hover {
            color: #D6B98C;
            border-color: #D6B98C;
        }

    /* SECTION */
    .tm-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 30px 0 20px;
        color: #0A111D;
        font-size: 19px;
        font-weight: 800;
    }

        .tm-section-title i {
            color: #B99766;
        }

    /* STATISTICS */
    .tm-stat {
        height: 100%;
        padding: 21px;
        background: white;
        border: 1px solid #E8ECF2;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(10,17,29,.035);
        transition: .2s;
    }

        .tm-stat:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(10,17,29,.07);
        }

    .tm-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .tm-stat-label {
        color: #7B8798;
        font-size: 13px;
        font-weight: 600;
    }

    .tm-stat-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #F1F4F8;
        color: #132C4F;
        font-size: 20px;
    }

    .tm-stat-number {
        color: #0A111D;
        font-size: 27px;
        font-weight: 800;
    }

    .tm-stat-note {
        margin-top: 4px;
        color: #9AA5B4;
        font-size: 12px;
    }

    /* CONTENT */
    .tm-content {
        margin-top: 28px;
        overflow: hidden;
        background: white;
        border: 1px solid #E8ECF2;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(10,17,29,.035);
    }

    .tm-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #EEF0F4;
    }

        .tm-content-header h5 {
            margin: 0;
            color: #132C4F;
            font-size: 17px;
            font-weight: 800;
        }

        .tm-content-header p {
            margin: 6px 0 0;
            color: #8A96A7;
            font-size: 12px;
        }

    /* SEARCH */
    .tm-search {
        position: relative;
        min-width: 230px;
    }

        .tm-search i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9AA5B4;
        }

        .tm-search input,
        .tm-filter {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #E2E7EF;
            border-radius: 9px;
            outline: none;
            background: white;
            color: #344054;
            font-size: 13px;
        }

        .tm-search input {
            padding-left: 38px;
        }

            .tm-search input:focus,
            .tm-filter:focus {
                border-color: #B99766;
                box-shadow: 0 0 0 3px rgba(214,185,140,.15);
            }

    .tm-filter {
        min-width: 155px;
    }

    /* TABLE */
    .tm-table {
        margin: 0;
        white-space: nowrap;
    }

        .tm-table thead th {
            padding: 16px 14px;
            background: #F5F7FA;
            color: #68778B;
            border-bottom: 1px solid #E8ECF2;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .4px;
        }

        .tm-table tbody td {
            padding: 15px 14px;
            border-bottom: 1px solid #F0F2F5;
            vertical-align: middle;
            color: #475467;
            font-size: 13px;
        }

        .tm-table tbody tr:hover {
            background: #FAFBFD;
        }

        .tm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tm-product-image {
        width: 62px;
        height: 62px;
        object-fit: cover;
        border: 1px solid #E8ECF2;
        border-radius: 10px;
        background: #F8F9FC;
    }

    .tm-image-placeholder {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #F1F4F8;
        color: #9AA5B4;
        font-size: 23px;
    }

    .tm-product-name {
        min-width: 150px;
        max-width: 220px;
        color: #132C4F;
        font-weight: 750;
        white-space: normal;
    }

    .tm-product-id {
        margin-top: 5px;
        color: #9AA5B4;
        font-size: 11px;
    }

    .tm-price {
        color: #132C4F;
        font-weight: 800;
    }

    .tm-stock {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 8px;
        background: #EDF3F8;
        color: #274B70;
        font-weight: 700;
    }

        .tm-stock.low {
            background: #FFF3E8;
            color: #B96A25;
        }

    .tm-category {
        display: inline-block;
        padding: 6px 9px;
        border-radius: 7px;
        background: #F1F4F8;
        color: #536579;
        font-size: 12px;
        font-weight: 600;
    }

    .tm-attribute {
        color: #68778B;
        font-size: 12px;
    }

    .tm-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

        .tm-status.active {
            background: #E8F4EC;
            color: #287747;
        }

        .tm-status.hidden {
            background: #F0F2F5;
            color: #68778B;
        }

    /* ACTIONS */
    .tm-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-width: 185px;
    }

    .tm-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 8px 10px;
        border: none;
        border-radius: 7px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: .2s;
        cursor: pointer;
    }

    .tm-action-variant {
        background: #EDF0F7;
        color: #274B70;
    }

        .tm-action-variant:hover {
            background: #132C4F;
            color: white;
        }

    .tm-action-edit {
        background: #F7F0E5;
        color: #99713D;
    }

        .tm-action-edit:hover {
            background: #D6B98C;
            color: #0A111D;
        }

    .tm-action-hide {
        background: #FCEBEC;
        color: #B4232E;
    }

        .tm-action-hide:hover {
            background: #B4232E;
            color: white;
        }

    .tm-action-show {
        background: #E8F4EC;
        color: #287747;
    }

        .tm-action-show:hover {
            background: #287747;
            color: white;
        }

    /* EMPTY */
    .tm-empty {
        padding: 60px 20px;
        text-align: center;
    }

    .tm-empty-icon {
        width: 78px;
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border-radius: 22px;
        background: #F1F4F8;
        color: #274B70;
        font-size: 34px;
    }

    .tm-empty h5 {
        color: #132C4F;
        font-weight: 800;
    }

    .tm-empty p {
        color: #8A96A7;
        font-size: 13px;
    }

    .tm-footer {
        padding: 15px 22px;
        border-top: 1px solid #EEF0F4;
        color: #8A96A7;
        font-size: 12px;
    }

    .tm-alert {
        border: none;
        border-radius: 10px;
        padding: 14px 18px;
    }

    @@media (max-width: 768px) {
        .tm-page {
            padding: 25px 0 40px;
        }

        .tm-container {
            padding: 0 15px;
        }

        .tm-hero {
            padding: 27px 22px;
        }

            .tm-hero h2 {
                font-size: 22px;
            }

        .tm-hero-icon {
            display: none;
        }

        .tm-content-header {
            padding: 18px;
        }

        .tm-search,
        .tm-filter {
            width: 100%;
        }
    }
</style>

<div class="tm-page">
    <div class="tm-container">

        <!-- HEADER -->
        <div class="tm-hero">
            <div class="row align-items-center">
                <div class="col-lg-8 tm-hero-content">
                    <div class="tm-eyebrow">
                        <i class="bi bi-shop-window"></i>
                        Store Management
                    </div>

                    <h2>
                        <i class="bi bi-box-seam me-2"></i>
                        QUẢN LÝ SẢN PHẨM
                    </h2>

                    <p>
                        Quản lý danh sách sản phẩm, cập nhật thông tin,
                        giá bán và tình trạng kinh doanh của cửa hàng.
                    </p>

                    <div class="tm-store-label">
                        <i class="bi bi-shop"></i>
                        Cửa hàng: @(ViewBag.StoreName ?? "Cửa hàng của bạn")
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <div class="tm-hero-icon mb-3">
                        <i class="bi bi-bag-check"></i>
                    </div>

                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                        <a asp-area="Store"
                           asp-controller="Dashboard"
                           asp-action="Index"
                           class="tm-btn tm-btn-outline">
                            <i class="bi bi-house-door"></i>
                            Dashboard
                        </a>

                        <a asp-area="Store"
                           asp-controller="Product"
                           asp-action="Create"
                           class="tm-btn tm-btn-gold">
                            <i class="bi bi-plus-circle"></i>
                            Thêm sản phẩm
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MESSAGE -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show tm-alert"
                 role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show tm-alert"
                 role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- STATISTICS -->
        <h4 class="tm-section-title">
            <i class="bi bi-bar-chart-line-fill"></i>
            Tổng quan sản phẩm
        </h4>

        <div class="row g-3">

            <div class="col-6 col-xl-3">
                <div class="tm-stat">
                    <div class="tm-stat-top">
                        <span class="tm-stat-label">Tổng sản phẩm</span>
                        <div class="tm-stat-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                    <div class="tm-stat-number">@totalProducts</div>
                    <div class="tm-stat-note">Sản phẩm trong cửa hàng</div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tm-stat">
                    <div class="tm-stat-top">
                        <span class="tm-stat-label">Đang bán</span>
                        <div class="tm-stat-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                    <div class="tm-stat-number">@activeProducts</div>
                    <div class="tm-stat-note">Sản phẩm đang hiển thị</div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tm-stat">
                    <div class="tm-stat-top">
                        <span class="tm-stat-label">Đã ẩn</span>
                        <div class="tm-stat-icon">
                            <i class="bi bi-eye-slash"></i>
                        </div>
                    </div>
                    <div class="tm-stat-number">@hiddenProducts</div>
                    <div class="tm-stat-note">Sản phẩm chưa hiển thị</div>
                </div>
            </div>

            <div class="col-6 col-xl-3">
                <div class="tm-stat">
                    <div class="tm-stat-top">
                        <span class="tm-stat-label">Tổng tồn kho</span>
                        <div class="tm-stat-icon">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                    <div class="tm-stat-number">@totalStock</div>
                    <div class="tm-stat-note">Tổng số lượng sản phẩm</div>
                </div>
            </div>

        </div>

        <!-- PRODUCT LIST -->
        <div class="tm-content">

            <div class="tm-content-header">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5>
                            <i class="bi bi-list-ul me-2"></i>
                            Danh sách sản phẩm
                        </h5>
                        <p>Quản lý và cập nhật các sản phẩm của cửa hàng</p>
                    </div>

                    @if (products.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            <div class="tm-search">
                                <i class="bi bi-search"></i>
                                <input type="text"
                                       id="productSearch"
                                       placeholder="Tìm tên sản phẩm..." />
                            </div>

                            <select id="productStatusFilter" class="tm-filter">
                                <option value="">Tất cả trạng thái</option>
                                <option value="active">Đang bán</option>
                                <option value="hidden">Đã ẩn</option>
                            </select>
                        </div>
                    }
                </div>
            </div>

            @if (products.Any())
            {
                <div class="table-responsive">
                    <table class="table tm-table align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>HÌNH ẢNH</th>
                                <th>SẢN PHẨM</th>
                                <th>DANH MỤC</th>
                                <th>GIÁ BÁN</th>
                                <th>TỒN KHO</th>
                                <th>SIZE</th>
                                <th>MÀU SẮC</th>
                                <th>TRẠNG THÁI</th>
                                <th>THAO TÁC</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in products)
                            {
                                <tr class="product-row"
                                    data-name="@item.Name"
                                    data-status="@(item.IsActive ? "active" : "hidden")">

                                    <td>
                                        <span class="text-muted fw-bold">
                                            #@item.Id
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 class="tm-product-image" />
                                        }
                                        else
                                        {
                                            <div class="tm-image-placeholder">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="tm-product-name">
                                            @item.Name
                                        </div>
                                        <div class="tm-product-id">
                                            Mã sản phẩm: #@item.Id
                                        </div>
                                    </td>

                                    <td>
                                        <span class="tm-category">
                                            #@item.CategoryId
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tm-price">
                                            @item.Price.ToString("N0") đ
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tm-stock @(item.Quantity <= 5 ? "low" : "")">
                                            <i class="bi bi-box"></i>
                                            @item.Quantity
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tm-attribute">
                                            @(string.IsNullOrWhiteSpace(item.Size)
                                                ? "Theo biến thể"
                                                : item.Size)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tm-attribute">
                                            @(string.IsNullOrWhiteSpace(item.Color)
                                                ? "Theo biến thể"
                                                : item.Color)
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="tm-status active">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Đang bán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="tm-status hidden">
                                                <i class="bi bi-eye-slash-fill"></i>
                                                Đã ẩn
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="tm-actions">

                                            <a asp-area="Store"
                                               asp-controller="Product"
                                               asp-action="Variants"
                                               asp-route-productId="@item.Id"
                                               class="tm-action tm-action-variant">
                                                <i class="bi bi-palette"></i>
                                                Biến thể
                                            </a>

                                            <a asp-area="Store"
                                               asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="tm-action tm-action-edit">
                                                <i class="bi bi-pencil-square"></i>
                                                Sửa
                                            </a>

                                            <form asp-area="Store"
                                                  asp-controller="Product"
                                                  asp-action="ToggleStatus"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                @if (item.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="tm-action tm-action-hide"
                                                            onclick="return confirm('Bạn có chắc muốn ẩn sản phẩm này?');">
                                                        <i class="bi bi-eye-slash"></i>
                                                        Ẩn
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="tm-action tm-action-show"
                                                            onclick="return confirm('Bạn có chắc muốn hiển thị sản phẩm này?');">
                                                        <i class="bi bi-eye"></i>
                                                        Hiện
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }

                            <tr id="noProductResult" style="display:none;">
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-search fs-3 d-block mb-2"></i>
                                    Không tìm thấy sản phẩm phù hợp.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="tm-footer">
                    <i class="bi bi-info-circle me-1"></i>
                    Tổng cộng @totalProducts sản phẩm trong cửa hàng.
                    Tồn kho được hiển thị theo dữ liệu sản phẩm hiện tại.
                </div>
            }
            else
            {
                <div class="tm-empty">
                    <div class="tm-empty-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h5>Chưa có sản phẩm nào</h5>

                    <p>
                        Hãy thêm sản phẩm đầu tiên để bắt đầu kinh doanh trên TechMarket.
                    </p>

                    <a asp-area="Store"
                       asp-controller="Product"
                       asp-action="Create"
                       class="tm-btn tm-btn-gold">
                        <i class="bi bi-plus-circle"></i>
                        Thêm sản phẩm
                    </a>
                </div>
            }
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("productSearch");
        const statusFilter = document.getElementById("productStatusFilter");
        const rows = document.querySelectorAll(".product-row");
        const noResult = document.getElementById("noProductResult");

        function filterProducts() {
            if (!searchInput || !statusFilter) return;

            const keyword = searchInput.value.trim().toLowerCase();
            const selectedStatus = statusFilter.value;
            let visibleCount = 0;

            rows.forEach(row => {
                const name = (row.dataset.name || "").toLowerCase();
                const status = row.dataset.status || "";

                const matchesName = name.includes(keyword);
                const matchesStatus =
                    selectedStatus === "" || status === selectedStatus;

                const visible = matchesName && matchesStatus;

                row.style.display = visible ? "" : "none";

                if (visible) visibleCount++;
            });

            if (noResult) {
                noResult.style.display =
                    visibleCount === 0 ? "table-row" : "none";
            }
        }

        if (searchInput) {
            searchInput.addEventListener("input", filterProducts);
        }

        if (statusFilter) {
            statusFilter.addEventListener("change", filterProducts);
        }
    });
</script>
