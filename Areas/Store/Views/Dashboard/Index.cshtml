@model TechMarket.Models.Store

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý cửa hàng";
}

<style>
    .tm-store-dashboard {
        background: #F8F9FC;
        min-height: 80vh;
        padding: 45px 0 60px;
    }

    .tm-store-header {
        background: linear-gradient(135deg, #0A111D, #132C4F);
        border-radius: 18px;
        padding: 42px;
        color: white;
        margin-bottom: 40px;
        box-shadow: 0 12px 30px rgba(10,17,29,.12);
    }

        .tm-store-header h2 {
            font-size: 27px;
            font-weight: 750;
            margin-bottom: 12px;
        }

        .tm-store-header p {
            color: #B9C6D8;
            font-size: 14px;
            line-height: 1.8;
            margin-bottom: 0;
        }

    .tm-store-header-icon {
        width: 65px;
        height: 65px;
        border: 1px solid rgba(214,185,140,.5);
        color: #D6B98C;
        border-radius: 18px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
        background: rgba(255,255,255,.05);
    }

    .tm-store-home-btn {
        display: inline-block;
        color: #0A111D;
        background: #D6B98C;
        text-decoration: none;
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        transition: .25s;
    }

        .tm-store-home-btn:hover {
            background: #E7D2B2;
            color: #0A111D;
            transform: translateY(-2px);
        }

    .tm-store-section-title {
        color: #0A111D;
        font-size: 19px;
        font-weight: 750;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .tm-store-section-title i {
            color: #B99766;
        }

    .tm-store-card {
        display: block;
        height: 100%;
        background: white;
        border: 1px solid #E8ECF2;
        border-radius: 15px;
        padding: 27px;
        text-decoration: none;
        color: #0A111D;
        transition: .25s ease;
        box-shadow: 0 5px 18px rgba(10,17,29,.035);
    }

        .tm-store-card:hover {
            transform: translateY(-5px);
            border-color: #D6B98C;
            box-shadow: 0 14px 28px rgba(10,17,29,.09);
            color: #0A111D;
        }

    .tm-store-card-icon {
        width: 52px;
        height: 52px;
        border-radius: 13px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #F1F4F8;
        color: #132C4F;
        font-size: 23px;
        margin-bottom: 22px;
    }

    .tm-store-card h5 {
        font-size: 16px;
        font-weight: 750;
        margin-bottom: 10px;
    }

    .tm-store-card p {
        color: #7B8798;
        font-size: 13px;
        line-height: 1.8;
        min-height: 47px;
        margin-bottom: 20px;
    }

    .tm-store-card-link {
        color: #132C4F;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #EEF0F4;
        padding-top: 15px;
    }

        .tm-store-card-link i {
            transition: .2s;
        }

    .tm-store-card:hover .tm-store-card-link i {
        transform: translateX(5px);
    }

    .tm-store-info {
        background: white;
        border: 1px solid #E8ECF2;
        border-radius: 15px;
        padding: 26px;
        margin-top: 38px;
        box-shadow: 0 5px 18px rgba(10,17,29,.035);
    }

    .tm-store-info-title {
        color: #132C4F;
        font-size: 17px;
        font-weight: 750;
        padding-bottom: 17px;
        border-bottom: 1px solid #EEF0F4;
        margin-bottom: 20px;
    }

    .tm-store-info-label {
        color: #7B8798;
        font-size: 12px;
        margin-bottom: 6px;
    }

    .tm-store-info-value {
        color: #0A111D;
        font-size: 14px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .tm-store-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

        .tm-store-status.active {
            background: #E7F5EC;
            color: #247A46;
        }

        .tm-store-status.inactive {
            background: #FCEBEC;
            color: #B4232E;
        }

    .tm-store-notice {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: #F1F4F8;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 20px 23px;
        margin-top: 25px;
    }

        .tm-store-notice > i {
            color: #B99766;
            font-size: 22px;
        }

        .tm-store-notice strong {
            color: #132C4F;
            font-size: 14px;
        }

        .tm-store-notice p {
            color: #7B8798;
            font-size: 13px;
            line-height: 1.7;
            margin: 5px 0 0;
        }

    @@media (max-width: 767px) {
        .tm-store-dashboard {
            padding: 25px 0 40px;
        }

        .tm-store-header {
            padding: 28px 22px;
        }

            .tm-store-header h2 {
                font-size: 21px;
            }

        .tm-store-card {
            padding: 22px;
        }
    }
</style>

<div class="tm-store-dashboard">
    <div class="container">

        <!-- HEADER -->
        <div class="tm-store-header">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-shop-window"
                           style="color:#D6B98C;font-size:22px;"></i>

                        <span class="small text-uppercase"
                              style="color:#D6B98C;letter-spacing:2px;">
                            Store Management
                        </span>
                    </div>

                    <h2>TRUNG TÂM QUẢN LÝ CỬA HÀNG</h2>

                    <p>
                        Chào mừng bạn đến với khu vực quản lý cửa hàng.
                        Theo dõi sản phẩm, biến thể, đơn hàng và thông tin
                        kinh doanh của bạn trên TechMarket.
                    </p>

                    <div class="mt-3">
                        <span class="text-white-50 small">
                            Cửa hàng:
                        </span>
                        <strong style="color:#D6B98C;">
                            @Model.StoreName
                        </strong>
                    </div>
                </div>

                <div class="col-lg-3 text-lg-end mt-4 mt-lg-0">
                    <div class="tm-store-header-icon mb-3">
                        <i class="bi bi-speedometer2"></i>
                    </div>

                    <div>
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="tm-store-home-btn">
                            <i class="bi bi-house-door me-2"></i>
                            Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MANAGEMENT -->
        <h4 class="tm-store-section-title">
            <i class="bi bi-grid-fill"></i>
            Quản lý hoạt động
        </h4>

        <div class="row g-4">

            <!-- PRODUCTS -->
            <div class="col-md-6 col-xl-4">
                <a asp-area="Store"
                   asp-controller="Product"
                   asp-action="Index"
                   class="tm-store-card">

                    <div class="tm-store-card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h5>Quản lý sản phẩm</h5>

                    <p>
                        Thêm sản phẩm mới, cập nhật thông tin,
                        giá bán và hình ảnh sản phẩm.
                    </p>

                    <span class="tm-store-card-link">
                        Quản lý sản phẩm
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

            <!-- VARIANTS -->
            <div class="col-md-6 col-xl-4">
                <a asp-area="Store"
                   asp-controller="Product"
                   asp-action="Index"
                   class="tm-store-card">

                    <div class="tm-store-card-icon">
                        <i class="bi bi-tags"></i>
                    </div>

                    <h5>Quản lý biến thể</h5>

                    <p>
                        Theo dõi kích thước, màu sắc, SKU
                        và số lượng tồn kho của từng biến thể.
                    </p>

                    <span class="tm-store-card-link">
                        Quản lý biến thể
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

            <!-- ORDERS -->
            <div class="col-md-6 col-xl-4">
                <a asp-area="Store"
                   asp-controller="Order"
                   asp-action="Index"
                   class="tm-store-card">

                    <div class="tm-store-card-icon">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <h5>Quản lý đơn hàng</h5>

                    <p>
                        Xem đơn hàng của cửa hàng, xác nhận,
                        cập nhật trạng thái và xử lý đơn hàng.
                    </p>

                    <span class="tm-store-card-link">
                        Quản lý đơn hàng
                        <i class="bi bi-arrow-right"></i>
                    </span>
                </a>
            </div>

        </div>

        <!-- STORE INFORMATION -->
        <div class="tm-store-info">
            <div class="tm-store-info-title">
                <i class="bi bi-shop me-2"></i>
                Thông tin cửa hàng
            </div>

            <div class="row g-4">

                <div class="col-md-6 col-lg-4">
                    <div class="tm-store-info-label">Tên cửa hàng</div>
                    <div class="tm-store-info-value">
                        @Model.StoreName
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="tm-store-info-label">Số điện thoại</div>
                    <div class="tm-store-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "Chưa cập nhật"
                            : Model.Phone)
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="tm-store-info-label">Địa chỉ</div>
                    <div class="tm-store-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Address)
                            ? "Chưa cập nhật"
                            : Model.Address)
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="tm-store-info-label">Ngày tạo cửa hàng</div>
                    <div class="tm-store-info-value">
                        @Model.CreatedAt.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="tm-store-info-label">Trạng thái</div>
                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="tm-store-status active">
                                <i class="bi bi-check-circle me-1"></i>
                                Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="tm-store-status inactive">
                                <i class="bi bi-x-circle me-1"></i>
                                Chưa hoạt động
                            </span>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="tm-store-info-label">Mô tả cửa hàng</div>
                    <div class="tm-store-info-value">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "Chưa có mô tả cửa hàng."
                            : Model.Description)
                    </div>
                </div>

            </div>
        </div>

        <!-- NOTICE -->
        <div class="tm-store-notice">
            <i class="bi bi-info-circle-fill"></i>

            <div>
                <strong>Lưu ý dành cho chủ cửa hàng</strong>
                <p>
                    Vui lòng cập nhật thông tin sản phẩm và số lượng tồn kho
                    chính xác. Theo dõi đơn hàng thường xuyên để xử lý và
                    giao hàng đúng thời gian.
                </p>
            </div>
        </div>

    </div>
</div>
