@model IEnumerable<TechMarket.Models.DiscountCode>
@{ ViewData["Title"] = "Kho mã giảm giá"; var claimed = ViewBag.ClaimedIds as List<int> ?? new List<int>(); }
<div class="container py-5"><h2 class="fw-bold">Kho mã giảm giá</h2><p class="text-muted">Nhận voucher và sử dụng tại bước thanh toán.</p><a asp-action="MyCoupons" class="btn btn-outline-primary btn-sm mb-3">Mã giảm giá của tôi</a>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
<div class="row g-3">@foreach (var x in Model) { <div class="col-md-6 col-lg-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><span class="badge bg-primary mb-2">@x.Code</span><h4 class="fw-bold">@(x.DiscountType == "PERCENT" ? $"Giảm {x.DiscountValue}%" : $"Giảm {x.DiscountValue:N0}đ")</h4>@if (x.DiscountType == "PERCENT" && x.MaxDiscountAmount > 0) { <p class="text-muted">Giảm tối đa @x.MaxDiscountAmount.ToString("N0")đ</p> }<p>Đơn tối thiểu: @x.MinOrderAmount.ToString("N0")đ</p><p class="small text-muted">Hạn dùng: @x.EndAt.ToString("dd/MM/yyyy HH:mm")</p><p class="small">Còn @Math.Max(0, x.UsageLimit - x.UsedCount) lượt</p>@if (claimed.Contains(x.Id)) { <button class="btn btn-secondary w-100" disabled>Đã nhận</button> } else { <form asp-action="Claim" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-primary w-100">Nhận mã</button></form> }</div></div></div> }</div></div>
