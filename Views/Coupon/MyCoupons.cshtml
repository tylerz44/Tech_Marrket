@model IEnumerable<TechMarket.Models.UserCoupon>
@{ ViewData["Title"] = "Mã giảm giá của tôi"; }
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold">Mã giảm giá của tôi</h2><p class="text-muted">Các voucher bạn đã nhận và trạng thái sử dụng.</p></div><a asp-action="Index" class="btn btn-outline-primary">Kho mã đang mở</a></div>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table align-middle mb-0"><thead><tr><th>Mã</th><th>Mức giảm</th><th>Hạn dùng</th><th>Ngày nhận</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var item in Model) { var c = item.DiscountCode; var expired = !c.IsActive || c.EndAt < DateTime.Now || c.UsedCount >= c.UsageLimit; <tr><td class="fw-bold">@c.Code</td><td>@(c.DiscountType == "PERCENT" ? c.DiscountValue + "%" : c.DiscountValue.ToString("N0") + "đ")</td><td>@c.EndAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.ClaimedAt.ToString("dd/MM/yyyy")</td><td>@if (item.UsedAt.HasValue) { <span class="badge bg-secondary">Đã sử dụng</span> } else if (expired) { <span class="badge bg-danger">Hết hạn / hết lượt</span> } else { <span class="badge bg-success">Chưa sử dụng</span> }</td></tr> }
</tbody></table></div></div>
