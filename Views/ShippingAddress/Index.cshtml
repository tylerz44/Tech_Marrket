@model IEnumerable<TechMarket.Models.ShippingAddress>

@{
    ViewData["Title"] = "Sổ địa chỉ";
}

<style>
    .address-page {
        background: #F8F9FC;
        min-height: 75vh;
        padding: 40px 0 70px;
    }

    .address-card {
        background: white;
        border: 1px solid #E8EBF0;
        border-radius: 14px;
        padding: 22px;
        height: 100%;
        transition: .2s;
    }

    .address-card:hover {
        border-color: #7B96B4;
        box-shadow: 0 8px 25px rgba(10,17,29,.06);
    }

    .address-title {
        color: #0A111D;
        font-weight: 700;
    }

    .address-muted {
        color: #748094;
        font-size: 14px;
    }

    .address-primary {
        background: #0A111D;
        color: white;
        border-radius: 8px;
        padding: 10px 18px;
        text-decoration: none;
        font-weight: 600;
    }

    .address-primary:hover {
        background: #132C4F;
        color: white;
    }

    .address-default {
        display: inline-block;
        background: #EAF5EF;
        color: #198754;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .address-action {
        font-size: 13px;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="address-page">
    <div class="container">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="address-title mb-2">Sổ địa chỉ</h2>
                <p class="address-muted mb-0">
                    Quản lý các địa chỉ nhận hàng của bạn
                </p>
            </div>

            <a asp-action="Create" class="address-primary">
                <i class="bi bi-plus-lg me-2"></i>
                Thêm địa chỉ mới
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (Model.Any())
        {
            <div class="row g-3">
                @foreach (var address in Model)
                {
                    <div class="col-lg-6">
                        <div class="address-card">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="address-title mb-1">
                                        @address.AddressName
                                    </h5>

                                    @if (address.IsDefault)
                                    {
                                        <span class="address-default">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Mặc định
                                        </span>
                                    }
                                </div>

                                <i class="bi bi-geo-alt fs-4 text-secondary"></i>
                            </div>

                            <div class="mb-2">
                                <strong>@address.ReceiverName</strong>
                            </div>

                            <div class="address-muted mb-2">
                                <i class="bi bi-telephone me-2"></i>
                                @address.Phone
                            </div>

                            <div class="address-muted mb-3">
                                <i class="bi bi-house me-2"></i>
                                @address.Address
                            </div>

                            <hr />

                            <div class="d-flex flex-wrap gap-3 align-items-center">

                                <a asp-action="Edit"
                                   asp-route-id="@address.Id"
                                   class="address-action text-primary">
                                    <i class="bi bi-pencil me-1"></i>
                                    Chỉnh sửa
                                </a>

                                @if (!address.IsDefault)
                                {
                                    <form asp-action="SetDefault"
                                          asp-route-id="@address.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-link p-0 address-action text-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Đặt mặc định
                                        </button>
                                    </form>
                                }

                                <form asp-action="Delete"
                                      asp-route-id="@address.Id"
                                      method="post"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa địa chỉ này?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link p-0 address-action text-danger">
                                        <i class="bi bi-trash me-1"></i>
                                        Xóa
                                    </button>
                                </form>

                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center bg-white rounded-4 p-5">
                <i class="bi bi-geo-alt text-secondary" style="font-size:55px;"></i>

                <h5 class="mt-3 address-title">
                    Bạn chưa lưu địa chỉ nào
                </h5>

                <p class="address-muted">
                    Thêm địa chỉ để thanh toán nhanh hơn trong những lần mua tiếp theo.
                </p>

                <a asp-action="Create" class="address-primary d-inline-block mt-2">
                    Thêm địa chỉ đầu tiên
                </a>
            </div>
        }

    </div>
</div>
